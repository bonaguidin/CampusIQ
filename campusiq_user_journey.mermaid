---
title: Campus IQ — User Journey · Click to Download
---
flowchart TD
    classDef auto fill:#e8ecff,stroke:#5566aa,color:#222;
    classDef useract fill:#fff4e0,stroke:#cc8800,color:#222,stroke-width:2px;
    classDef engine fill:#e6f5e6,stroke:#4c994c,color:#222;
    classDef rep fill:#f5e8ff,stroke:#8844bb,color:#222,stroke-width:3px;
    classDef out fill:#e8ecff,stroke:#5566aa,color:#222;
    classDef chat fill:#fce8f0,stroke:#bb4488,color:#222;

    %% ── SHARED FRONT PATH · same for every student, every time ──
    Login["Student logs in"]:::useract
    Pull["Canvas pull → JSON build → Supabase\nautomatic · mocked for demo"]:::auto
    Onboard["Onboarding — first time only\ncareer fields Canvas can't supply"]:::useract
    Dash["Dashboard\nacademic + career snapshot"]:::auto
    Gate{"Completeness gate\nchecks by_feature.ready"}:::auto
    Login --> Pull --> Onboard --> Dash --> Gate

    %% ── TRIGGER · what the student clicks ──
    Trig{"What does the student trigger?"}:::useract
    Gate --> Trig

    %% PATH 1 · FULL ANALYSIS
    Full["clicks 'Full Analysis'"]:::useract
    Agents7["all 7 agents fire in parallel\nFIT · GAP · SHIFT + 4 academic"]:::engine
    Synth["Career Synthesis\nmerges FIT + GAP + SHIFT"]:::engine
    Trig --> Full --> Agents7 --> Synth

    %% PATH 2 · SINGLE FEATURE
    Single["clicks 'Run GAP'\none feature"]:::useract
    OneAgent["that one agent fires\n← your prompt handles this"]:::engine
    Trig --> Single --> OneAgent

    %% PATH 3 · CHAT
    Chat["opens Chat"]:::chat
    ChatLoop["conversational Q&A\nAI has record as context"]:::chat
    Trig --> Chat --> ChatLoop

    %% ── CONVERGENCE · every REPORT path routes through Rep ──
    Rep["REPORT GENERATOR (Rep)\nevery report path routes through here\n= ONE export contract"]:::rep
    Synth --> Rep
    OneAgent --> Rep

    %% ── OUTPUT ──
    Screen["renders on screen"]:::out
    Rep --> Screen
    ChatLoop --> Screen

    Download{"student clicks Download\npicks format"}:::useract
    Screen --> Download
    Export["Export script\nRep output → file\nLayer 5 · Person C"]:::out
    Download --> Export
    PDF["PDF"]:::out
    DOCX["DOCX"]:::out
    Export --> PDF
    Export --> DOCX

    %% chat can hand off into a feature run
    ChatLoop -. "can offer to run a feature" .-> Trig
