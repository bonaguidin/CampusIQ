{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/proxy.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/students/:student/analyze/:feature",
      "destination": "/api/proxy?student=:student&feature=:feature"
    },
    {
      "source": "/api/students/:student/chat",
      "destination": "/api/proxy?student=:student&feature=chat"
    },
    {
      "source": "/api/students/:student/profile",
      "destination": "/api/proxy?student=:student&feature=profile"
    },
    {
      "source": "/api/v2/student/me/analyze/:feature",
      "destination": "/api/proxy?target=me-analyze&feature=:feature"
    },
    {
      "source": "/api/v2/student/me/chat",
      "destination": "/api/proxy?target=me-chat"
    },
    {
      "source": "/api/v2/student/me/profile",
      "destination": "/api/proxy?target=me-profile"
    },
    {
      "source": "/api/v2/student/me/resume/upload",
      "destination": "/api/proxy?target=me-resume-upload"
    },
    {
      "source": "/api/v2/student/me/career/confirm",
      "destination": "/api/proxy?target=me-career-confirm"
    },
    {
      "source": "/api/v2/student/me/career/review",
      "destination": "/api/proxy?target=me-career-review"
    },
    {
      "source": "/api/v2/student/me/career/review/:table/:id",
      "destination": "/api/proxy?target=me-career-review-edit&table=:table&id=:id"
    },
    {
      "source": "/api/v2/student/me/transcript/upload",
      "destination": "/api/proxy?target=me-transcript-upload"
    },
    {
      "source": "/api/v2/student/me/transcript/review",
      "destination": "/api/proxy?target=me-transcript-review"
    },
    {
      "source": "/api/v2/student/me/transcript/review/:id",
      "destination": "/api/proxy?target=me-transcript-review-edit&id=:id"
    },
    {
      "source": "/api/v2/student/me/transcript/confirm",
      "destination": "/api/proxy?target=me-transcript-confirm"
    },
    {
      "source": "/api/v2/student/me/terms",
      "destination": "/api/proxy?target=me-terms"
    },
    {
      "source": "/api/v2/student/me/planned-courses/:id",
      "destination": "/api/proxy?target=me-planned-course-remove&id=:id"
    },
    {
      "source": "/api/v2/student/me/catalog/search",
      "destination": "/api/proxy?target=me-catalog-search&q=:q",
      "has": [{ "type": "query", "key": "q" }]
    },
    {
      "source": "/api/v2/student/me/planned-courses",
      "destination": "/api/proxy?target=me-planned-courses&term_id=:term_id",
      "has": [{ "type": "query", "key": "term_id" }]
    },
    {
      "source": "/api/v2/student/me/planned-courses",
      "destination": "/api/proxy?target=me-planned-courses"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
