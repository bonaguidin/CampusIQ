{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/proxy.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/students/:student/analyze/:feature",
      "destination": "/api/proxy?student=:student&feature=:feature"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
