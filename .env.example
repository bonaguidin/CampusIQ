OPENROUTER_API_KEY=your-openrouter-key-here
TAVILY_API_KEY=your-tavily-key-here

# Shared server-to-server credential. Configure the same strong random value in
# Vercel and Render. Never prefix it with VITE_ or expose it to browser code.
CAMPUSIQ_PROXY_SECRET=replace-with-a-strong-random-secret

# Render backend configuration. CORS is browser policy, not authentication.
CAMPUSIQ_ALLOWED_ORIGINS=http://localhost:5173
CAMPUSIQ_RATE_LIMIT_REQUESTS=10
CAMPUSIQ_RATE_LIMIT_WINDOW_SECONDS=60
CAMPUSIQ_MAX_CONCURRENT_AI_REQUESTS=2

# Vercel server-side function only. Production should use the HTTPS Render URL.
CAMPUSIQ_BACKEND_URL=http://localhost:8000

# Optional role-based OpenRouter model overrides.
# Leave blank to use the central defaults in CampusIQ_career/ai/model_config.py.
CAMPUSIQ_MODEL_ORCHESTRATOR=
# CAMPUSIQ_MODEL_CAREER and CAMPUSIQ_MODEL_ACADEMIC already default to the
# validated deepseek/deepseek-r1-0528 in model_config.py; only set these if
# overriding that default.
CAMPUSIQ_MODEL_CAREER=
CAMPUSIQ_MODEL_ACADEMIC=
CAMPUSIQ_MODEL_PARSING=
CAMPUSIQ_MODEL_CHAT=
CAMPUSIQ_MODEL_REPORT=
